# ============================================================
# Omni-Agent Trading Nexus — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real credentials.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# Google Gemini API (used by LangChain agents for LLM inference)
GOOGLE_API_KEY=your_google_api_key_here

# Alpaca Trading API (paper or live)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ============================================================
# Authentication
# ============================================================
# API secret used to authenticate REST and WebSocket requests.
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_API_SECRET=your_api_secret_here

# Optional: Override the default CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
